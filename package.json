{
  "name": "sidc",
  "productName": "SIDC",
  "version": "0.1.0",
  "description": "Suite System Intelligence - Desenvolvimento de Canais",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.edgarsgs.sidc",
    "productName": "SIDC",
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "publisherName": "SIDC"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "true",
      "createDesktopShortcutForAllUsers": false
    }
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1"
  }
}
